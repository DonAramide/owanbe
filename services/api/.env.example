NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5436/owanbe
# If local PostgreSQL already uses 5432, map Docker to 5436 in docker-compose.yml (see repo root).
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-from-dashboard-jwt-keys
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Dot-paths inside decoded JWT payload (Supabase: use Auth Hook or app_metadata)
JWT_TENANT_CLAIM_PATH=app_metadata.tenant_id
JWT_ROLES_CLAIM_PATH=app_metadata.roles

# Authoritative roles cache (DB lookup per user, short TTL)
ROLES_CACHE_TTL_MS=45000

# Payments / Quaser (PUBLIC_API_BASE_URL required to create payments so webhooks resolve)
# Local Quasar Financial Sandbox (default port 4000):
#   QUASER_ROUTER_BASE_URL=http://localhost:4000
#   PUBLIC_API_BASE_URL=http://localhost:8080
#   Quasar Admin webhook URL → http://localhost:8080/webhooks/quaser
# Optional: expose Owanbe only via ngrok when Quasar runs remotely:
#   PUBLIC_API_BASE_URL=https://YOUR-OWANBE-TUNNEL.ngrok-free.dev
QUASER_ROUTER_BASE_URL=http://localhost:4000
QUASER_ROUTER_API_KEY=
QUASER_WEBHOOK_SECRET=
PAYMENT_S2S_VERIFY_THRESHOLD_MINOR=500000
PAYOUT_COOLDOWN_FALLBACK_HOURS=36
PUBLIC_API_BASE_URL=http://localhost:8080

# User-facing web/app origin for invitation RSVP deep links (NOT the API).
# Production/staging MUST set this to a publicly reachable app URL, e.g.:
#   PUBLIC_APP_BASE_URL=https://app.owanbe.com
# Local Cloudflare dev tunnel (Customer app only — see docs/DEV_TUNNEL_SETUP.md):
#   PUBLIC_APP_BASE_URL=https://dev.owanbe.com
# Do not set this to PUBLIC_API_BASE_URL — RSVP links must open the app, not the API host.
PUBLIC_APP_BASE_URL=
# Optional legacy alias (prefer PUBLIC_APP_BASE_URL):
# APP_PUBLIC_URL=

ALERT_WEBHOOK_URL=
ALERT_EMAIL_TO=
ALERT_DEDUPE_WINDOW_MS=120000
PAYMENT_TIMEOUT_MINUTES=30
PAYOUT_TIMEOUT_MINUTES=240
FINANCE_TIMEOUT_SWEEP_MS=60000

# QFE Sprint S5: treasury settlement dual-write (default off)
QFE_DUAL_WRITE_TREASURY=false

# Phase 9 — Production Integrations
# INTEGRATIONS_MODE=production  # disables payment auto-stub; requires Quaser URL
INTEGRATIONS_MODE=development

# Enterprise Email Infrastructure
# SMTP credentials are NOT stored here — configure via Super Admin → Enterprise Email.
# REQUIRED — encrypt provider secrets at rest (32+ chars or 64-char hex). API will not start without this:
EMAIL_SECRETS_ENCRYPTION_KEY=replace-with-a-long-random-secret-at-least-32-chars
# Optional: sync default SMTP provider → Supabase Auth (Owner/Admin PAT):
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=   # or derive from SUPABASE_URL

# Deprecated for business email (kept for reference only — do not set for new deploys):
# RESEND_API_KEY=
# NOTIFICATION_FROM_EMAIL=

NOTIFICATION_WEBHOOK_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=owanbe-media

# Phase 3A — CRM realtime SSE (hybrid with REST + existing 5s polling). Set false to disable.
CRM_REALTIME_SSE=true
# Multi-instance fan-out: pg_notify (PostgreSQL LISTEN/NOTIFY) | local (in-process only)
CRM_REALTIME_FANOUT=pg_notify
